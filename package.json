{
  "name": "4planet-v1-world",
  "private": true,
  "version": "40.0.0-experiment",
  "type": "module",
  "description": "4PLANET public mission platform.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-xr-canonical-data.mjs && node scripts/write-product-build.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets:verify": "node scripts/verify-assets.mjs",
    "lint": "eslint src",
    "test:smoke": "node --test scripts/smoke-v40.mjs scripts/prototype-contracts.test.mjs scripts/product-context.test.mjs scripts/species-gold-truth.test.mjs scripts/xr-scene-contract.test.mjs scripts/jaguar-3d-contract.test.mjs",
    "test:contracts": "node --test scripts/prototype-contracts.test.mjs scripts/product-context.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
