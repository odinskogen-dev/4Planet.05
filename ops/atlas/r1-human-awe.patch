+.alyr-name { font-size: 15px; font-weight: 500; color: var(--atlas-ink); }
+.alyr-what { font-size: 13px; line-height: 1.35; color: var(--atlas-ink-2); }
+.switch {
+  flex: 0 0 auto; position: relative; width: 44px; height: 26px; border-radius: 999px;
