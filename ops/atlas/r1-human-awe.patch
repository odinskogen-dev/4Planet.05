+    return { title: `Magnitude ${mag} earthquake`, detail: s.summary ?? "" };
+  }
+  const raw = String(s.title || "");
+  const title = EVENT_HEADLINE[raw] ?? (raw.charAt(0) + raw.slice(1).toLowerCase());
+  return { title, detail: s.summary ?? "" };
+};
