@@ -0,0 +1,105 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { existsSync, readFileSync } from "node:fs";
+
+/**
+ * CANONICAL OWNERSHIP CONTRACT
+ *
+ * One repository renders several public hosts. Two hosts must never tell a
+ * crawler two different things about the same page. This contract pins:
+ *   · ATLAS + PLACE routes canonicalise to https://4planetatlas.com in EVERY build;
+ *   · the ATLAS root is "/" ("/atlas" is the compatibility route);
+ *   · SPECIES / LIVING SYSTEMS / everything else is untouched (MAIN host);
+ *   · build-side (scripts) and runtime-side (src) resolve identically.
+ */
+const resolveWith = (env) => JSON.parse(execFileSync(process.execPath, ["--input-type=module", "-e", `
+  const m = await import(${JSON.stringify(new URL("./seo-ownership.mjs", import.meta.url).href)});
+  const paths = ["/", "/atlas", "/atlas?l=fires&z=3", "/atlas/fires", "/places", "/place/kenya", "/place/kenya/", "/species/orca", "/living-systems/oslofjord", "/magazine", "/now"];
+  console.log(JSON.stringify({ isAtlas: m.IS_ATLAS_BUILD, main: m.MAIN_ORIGIN, atlas: m.ATLAS_ORIGIN,
+    canonical: Object.fromEntries(paths.map((p) => [p, m.canonicalUrl(p)])),
+    absolute: { deep: m.absoluteUrl("/atlas?l=fires&z=3"), species: m.absoluteUrl("/species/orca") } }));
+`], { env: { ...process.env, PUBLIC_SITE_ORIGIN: "", VITE_PUBLIC_SITE_ORIGIN: "", PUBLIC_MAIN_ORIGIN: "", PUBLIC_ATLAS_ORIGIN: "", ...env }, encoding: "utf8" }));
+
+const expectOwnership = (r) => {
+  assert.equal(r.canonical["/atlas"], "https://4planetatlas.com/");
+  assert.equal(r.canonical["/atlas?l=fires&z=3"], "https://4planetatlas.com/", "query strings never canonicalise");
+  assert.equal(r.canonical["/atlas/fires"], "https://4planetatlas.com/atlas/fires");
+  assert.equal(r.canonical["/places"], "https://4planetatlas.com/places");
+  assert.equal(r.canonical["/place/kenya"], "https://4planetatlas.com/place/kenya");
+  assert.equal(r.canonical["/place/kenya/"], "https://4planetatlas.com/place/kenya", "trailing slash is normalised");
+  assert.equal(r.canonical["/species/orca"], "https://4planet.org/species/orca", "SPECIES ownership is not moved");
+  assert.equal(r.canonical["/living-systems/oslofjord"], "https://4planet.org/living-systems/oslofjord", "LIVING SYSTEMS ownership is not moved");
+  assert.equal(r.canonical["/magazine"], "https://4planet.org/magazine");
+  assert.equal(r.absolute.deep, "https://4planetatlas.com/?l=fires&z=3", "deep ATLAS links keep their state on the ATLAS host");
+  assert.equal(r.absolute.species, "https://4planet.org/species/orca");
+};
+
+test("main build: ATLAS and PLACE routes canonicalise to the standalone ATLAS host", () => {
+  const r = resolveWith({});
+  assert.equal(r.isAtlas, false);
+  assert.equal(r.canonical["/"], "https://4planet.org/");
+  expectOwnership(r);
+});
+
+test("dedicated ATLAS build: owns ATLAS and PLACE, never claims SPECIES / LIVING SYSTEMS / MAGAZINE", () => {
+  const r = resolveWith({ PUBLIC_SITE_ORIGIN: "https://4planetatlas.com", VITE_PUBLIC_SITE_ORIGIN: "https://4planetatlas.com" });
+  assert.equal(r.isAtlas, true);
+  assert.equal(r.main, "https://4planet.org");
+  expectOwnership(r);
+});
+
+test("www and trailing-slash origins are recognised as the ATLAS build", () => {
+  assert.equal(resolveWith({ PUBLIC_SITE_ORIGIN: "https://www.4planetatlas.com/" }).isAtlas, true);
+  assert.equal(resolveWith({ PUBLIC_SITE_ORIGIN: "https://test.4planet.org" }).isAtlas, false);
+});
+
+test("runtime ownership agrees with build ownership", async () => {
+  const runtime = await import("../src/seo/ownership.ts");
+  const build = resolveWith({});
+  for (const [path, expected] of Object.entries(build.canonical)) {
+    if (path === "/") continue; // "/" belongs to whichever host serves it
+    assert.equal(runtime.canonicalUrlFor(path, "https://4planet.org"), expected, `runtime ≠ build for ${path}`);
+    // The same page rendered on the ATLAS host must say exactly the same thing.
+    assert.equal(runtime.canonicalUrlFor(path, "https://4planetatlas.com"), expected, `ATLAS-host runtime ≠ build for ${path}`);
+  }
+  assert.equal(runtime.isAtlasHost("4planetatlas.com"), true);
+  assert.equal(runtime.isAtlasHost("www.4planetatlas.com"), true);
+  assert.equal(runtime.isAtlasHost("4planet.org"), false);
+  assert.equal(runtime.isAtlasHost("4species.com"), false);
+});
+
+test("every SEO writer resolves origins through the ownership module", () => {
+  const read = (p) => readFileSync(new URL(`../${p}`, import.meta.url), "utf8");
+  for (const file of ["scripts/generate-sitemap.mjs", "scripts/prerender-atlas-seo.mjs", "scripts/prerender-discovery-seo.mjs", "scripts/prerender-magazine-seo.mjs", "scripts/finalize-atlas-host.mjs"]) {
+    const source = read(file);
+    assert.match(source, /seo-ownership\.mjs/, `${file} must use the ownership module`);
+    assert.doesNotMatch(source, /process\.env\.PUBLIC_SITE_ORIGIN\s*\|\|/, `${file} must not resolve its own origin`);
+  }
+  assert.match(read("src/components/Seo.tsx"), /canonicalUrlFor\(path, origin\)/);
+  assert.match(read("src/routes/router.tsx"), /isAtlasHost\(\)/, "the ATLAS host root must open the map");
+});
+
+test("a dedicated ATLAS artifact, when present, says one consistent thing to a crawler", { skip: !(existsSync(new URL("../dist/robots.txt", import.meta.url)) && readFileSync(new URL("../dist/robots.txt", import.meta.url), "utf8").includes("4planetatlas.com")) }, () => {
+  const dist = (p) => readFileSync(new URL(`../dist/${p}`, import.meta.url), "utf8");
+  const canonicalOf = (html) => /<link rel="canonical" href="([^"]+)"/.exec(html)?.[1];
+  assert.equal(canonicalOf(dist("index.html")), "https://4planetatlas.com/");
+  assert.equal(canonicalOf(dist("atlas/index.html")), "https://4planetatlas.com/");
+  assert.equal(canonicalOf(dist("places/index.html")), "https://4planetatlas.com/places");
+  assert.equal(canonicalOf(dist("place/oslofjord/index.html")), "https://4planetatlas.com/place/oslofjord");
+  assert.equal(canonicalOf(dist("species/orca/index.html")), "https://4planet.org/species/orca");
+  assert.match(dist("index.html"), /<h1>One planet\. Many ways to see it\.<\/h1>/, "the root is real crawlable HTML");
+  const robots = dist("robots.txt");
+  assert.match(robots, /Sitemap: https:\/\/4planetatlas\.com\/sitemap\.xml/);
+  assert.doesNotMatch(robots, /4planet\.org/);
+  const sitemap = dist("sitemap.xml");
+  const locs = [...sitemap.matchAll(/<loc>([^<]+)<\/loc>/g)].map((m) => m[1]);
+  assert.ok(locs.includes("https://4planetatlas.com/"));
+  assert.ok(locs.includes("https://4planetatlas.com/place/oslofjord"));
+  assert.ok(locs.every((loc) => loc.startsWith("https://4planetatlas.com/")), "only ATLAS-owned URLs");
+  assert.ok(!locs.some((loc) => /\/species|\/living-systems|\/magazine/.test(loc)), "no SPECIES / LIVING SYSTEMS / MAGAZINE URLs");
+  assert.ok(!locs.includes("https://4planetatlas.com/atlas"), "the compatibility route is not listed");
+  const redirects = dist("_redirects");
+  assert.doesNotMatch(redirects, /^\/\s+\/atlas\s+30\d/m, "the root is a real page, not a redirect");
+  assert.match(redirects, /^\/\*\s+\/index\.html\s+200/m);
+});
diff --git a/scripts/seo-ownership.mjs b/scripts/seo-ownership.mjs
new file mode 100644
index 0000000..fdd1594
--- /dev/null
+++ b/scripts/seo-ownership.mjs
@@ -0,0 +1,75 @@
+/**
+ * 4PLANET — CANONICAL URL OWNERSHIP (build side)
+ *
+ * One repository renders several public hosts. Which host OWNS a route in search
+ * is a product decision, not a side effect of which host happened to build it:
+ *
+ *   ATLAS  https://4planetatlas.com   →  /  ·  /atlas  ·  /atlas/*  ·  /places  ·  /place/*
+ *   MAIN   https://4planet.org        →  everything else in this build
+ *
+ * SPECIES and LIVING SYSTEMS ownership is deliberately untouched here: they keep
+ * the MAIN origin exactly as before. Do not move them as collateral work.
+ *
+ * Keep in step with src/seo/ownership.ts (runtime). scripts/seo-ownership-contract
+ * .test.mjs fails if the two disagree.
+ */
+const clean = (value) => String(value || "").trim().replace(/\/+$/, "");
+
+export const ATLAS_ORIGIN = clean(process.env.PUBLIC_ATLAS_ORIGIN) || "https://4planetatlas.com";
+export const DEFAULT_MAIN_ORIGIN = "https://4planet.org";
+
+/** The origin this build will be SERVED from. */
+export const BUILD_ORIGIN = clean(process.env.PUBLIC_SITE_ORIGIN || process.env.VITE_PUBLIC_SITE_ORIGIN) || DEFAULT_MAIN_ORIGIN;
+
+const hostOf = (origin) => { try { return new URL(origin).hostname.replace(/^www\./, "").toLowerCase(); } catch { return ""; } };
+
+/** True when this build is the dedicated standalone ATLAS deployment. */
+export const IS_ATLAS_BUILD = hostOf(BUILD_ORIGIN) === hostOf(ATLAS_ORIGIN);
+
+/** Origin that owns every non-ATLAS route. An ATLAS build never claims them. */
+export const MAIN_ORIGIN = clean(process.env.PUBLIC_MAIN_ORIGIN) || (IS_ATLAS_BUILD ? DEFAULT_MAIN_ORIGIN : BUILD_ORIGIN);
+
+const pathOnly = (value) => {
+  const raw = String(value || "/");
+  const path = raw.split("#")[0].split("?")[0] || "/";
+  return path.length > 1 ? path.replace(/\/+$/, "") : "/";
+};
+
+export function isAtlasOwnedPath(value) {
+  const path = pathOnly(value);
+  return path === "/atlas" || path.startsWith("/atlas/") || path === "/places" || path.startsWith("/place/");
+}
+
+/** ATLAS lives at the root of its own host; /atlas is the compatibility route. */
+export function canonicalPath(value) {
+  const path = pathOnly(value);
+  return path === "/atlas" ? "/" : path;
+}
+
+/** Canonical absolute URL for a route. Query strings and fragments never canonicalise. */
+export function canonicalUrl(value) {
+  if (isAtlasOwnedPath(value)) return ATLAS_ORIGIN + canonicalPath(value);
+  return MAIN_ORIGIN + pathOnly(value);
+}
+
+/**
+ * Absolute URL for a link/asset reference inside structured data. Deep ATLAS
+ * links ("/atlas?l=fires") keep their query and point at the ATLAS host.
+ */
+export function absoluteUrl(value) {
+  const raw = String(value || "/");
+  if (/^https?:\/\//i.test(raw)) return raw;
+  const [path, rest = ""] = [raw.split(/[?#]/)[0], raw.slice(raw.split(/[?#]/)[0].length)];
+  if (isAtlasOwnedPath(path)) {
+    const target = canonicalPath(path);
+    return ATLAS_ORIGIN + (target === "/" && rest ? "/" + rest : target + rest);
+  }
+  return MAIN_ORIGIN + (path.startsWith("/") ? path : "/" + path) + rest;
+}
+
+/** Static assets are served by whichever host serves the page that references them. */
+export function assetUrl(value, forPath = "/") {
+  const raw = String(value || "/og.png");
+  if (/^https?:\/\//i.test(raw)) return raw;
+  return (isAtlasOwnedPath(forPath) ? ATLAS_ORIGIN : MAIN_ORIGIN) + (raw.startsWith("/") ? raw : "/" + raw);
+}
