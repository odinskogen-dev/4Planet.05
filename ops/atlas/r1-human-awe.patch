+/**
+ * The same elapsed time in words a person reads ("3 hours ago"). The uppercase
+ * token above stays for metadata lines; this is for the first read.
+ */
+export const timeAgoHuman = (iso?: string): string => {
+  if (!iso) return "time not given";
+  const ms = Date.now() - Date.parse(iso);
+  if (!Number.isFinite(ms) || ms < 0) return "time not given";
+  const minutes = Math.max(1, Math.floor(ms / 6e4));
+  if (minutes < 60) return `${minutes} min ago`;
+  const hours = Math.floor(minutes / 60);
+  if (hours < 24) return `${hours} ${hours === 1 ? "hour" : "hours"} ago`;
+  const days = Math.floor(hours / 24);
+  return days === 1 ? "yesterday" : `${days} days ago`;
+};
+
+/** Plain-language class names for the first read. CLASS_LABEL stays the metadata token. */
