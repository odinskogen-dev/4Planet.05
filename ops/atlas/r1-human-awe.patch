+.chain-rail { flex: 0 0 auto; width: 10px; display: flex; flex-direction: column; align-items: center; padding-top: 6px; align-self: stretch; }
+.chain-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; flex: 0 0 auto; box-shadow: 0 0 0 1px rgba(10, 10, 10, .18); }
+.chain-line { width: 1px; flex: 1; min-height: 16px; background: var(--atlas-line-strong); margin-top: 3px; }
+.chain-txt { flex: 1; min-width: 0; }
+.chain-name { font-size: 15px; font-weight: 500; color: var(--atlas-ink); }
+.chain-type { font-size: 12.5px; color: var(--atlas-ink-3); margin-top: 1px; }
+.chain-claim { font-size: 13.5px; line-height: 1.5; color: var(--atlas-ink-2); margin-top: 4px; }
+
+/* evidence envelope on a seeded relationship — bounded mono, metadata only */
+.ev { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 5px; font-family: var(--atlas-mono); font-size: 10.5px; letter-spacing: .02em; }
+.ev span { padding: 2px 6px; border-radius: 6px; background: var(--atlas-fill); color: var(--atlas-ink-2); }
+.ev-cite { font-size: 12.5px; line-height: 1.5; color: var(--atlas-ink-3); margin-top: 6px; }
+
+/* solution axes — three axes, never one badge */
+.axes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 6px; }
+.axis { padding: 10px 12px; border-radius: var(--atlas-r-s); background: var(--atlas-fill); }
+.axis .ak { font-size: 12px; color: var(--atlas-ink-3); }
+.axis .av { font-size: 13.5px; font-weight: 600; margin-top: 2px; overflow-wrap: anywhere; }
+
+/* preserved source preview inside the shared context (legacy parity) */
+.legacy-preview { font-size: 14px; line-height: 1.55; color: var(--atlas-ink-2); }
+.legacy-preview b { color: var(--atlas-ink); font-weight: 600; }
+.legacy-preview .lat { font-style: italic; }
+.legacy-preview .when { font-size: 13px; color: var(--atlas-ink-3); }
+.legacy-preview img { width: 100%; height: 120px; object-fit: cover; display: block; margin: 8px 0 4px; border-radius: var(--atlas-r-s); }
+.legacy-preview .pl { display: inline-block; margin-top: 6px; color: var(--atlas-blue); }
+
+/* ── LAYERS SHEET ───────────────────────────────────────────────────────── */
+.seg { display: flex; gap: 6px; flex-wrap: wrap; padding: 2px 0 4px; }
+.chip {
+  height: 44px; min-width: 44px; padding: 0 16px; cursor: pointer;
+  border: 1px solid var(--atlas-line-strong); border-radius: 999px; background: var(--atlas-paper);
+  font-size: 14px; font-weight: 500; color: var(--atlas-ink-2);
+}
+.chip.on { background: var(--atlas-ink); border-color: var(--atlas-ink); color: var(--atlas-paper); }
+.grp { margin: 22px 0 2px; font-size: 13px; font-weight: 600; letter-spacing: .01em; color: var(--atlas-ink-3); }
+.site-menu .rgrp { letter-spacing: .04em; }
+.layer { border-bottom: 1px solid var(--atlas-line); }
+.layer-group .layer:last-child { border-bottom: 0; }
