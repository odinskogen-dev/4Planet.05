+const EVENT_HEADLINE: Record<string, string> = {
+  "SEVERE STORM": "Severe storm",
+  "ICEBERG / SEA ICE": "Sea ice or iceberg",
+  "VOLCANIC ACTIVITY": "Volcanic activity",
+  "ACTIVE WILDFIRE": "Wildfire",
+};
