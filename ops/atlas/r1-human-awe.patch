diff --git a/tests/e2e/atlas-r1-human-awe.spec.ts b/tests/e2e/atlas-r1-human-awe.spec.ts
new file mode 100644
index 0000000..6c373cc
--- /dev/null
+++ b/tests/e2e/atlas-r1-human-awe.spec.ts
@@ -0,0 +1,321 @@
+import { test, expect, type Locator, type Page } from "@playwright/test";
+import { offlineWorld, openAtlas } from "./fixtures/atlasOfflineWorld";
+
+/**
+ * ATLAS R1 — HUMAN AWE FIRST · behavioural proof
+ *
+ * What a first-time visitor on a phone can feel, proven with real clicks against
+ * the running product. Providers are answered by deterministic fixtures
+ * (fixtures/atlasOfflineWorld.ts), so this proves ATLAS's own behaviour — one
+ * surface at a time, human first read, honest gaps, working map — not the
+ * availability of NASA or GBIF on the day.
+ *
+ * It does NOT prove: real provider responses, real basemap labels, real-device
+ * Safari behaviour or the credentialed 4PLANET ID journey. Those stay AXE/human gates.
+ */
+const COMPACT = ["mobile-390", "mobile-430", "webkit-390", "webkit-430"];
+const compactOnly = (name: string) => test.skip(!COMPACT.includes(name), "compact-screen proof");
+
+type Box = { x: number; y: number; width: number; height: number };
+const overlaps = (a: Box, b: Box) => a.x < b.x + b.width - 0.5 && a.x + a.width > b.x + 0.5 && a.y < b.y + b.height - 0.5 && a.y + a.height > b.y + 0.5;
+const boxOf = async (locator: Locator) => { await expect(locator).toBeVisible(); return (await locator.boundingBox())!; };
+const surface = (page: Page) => page.locator(".world").getAttribute("data-atlas-surface");
+const camera = (page: Page) => page.evaluate(() => { const m = (window as any).__4planet_map; const c = m.getCenter(); return { zoom: m.getZoom(), lng: c.lng, lat: c.lat }; });
+
+/** Every visible control is a real touch target and no text is smaller than 12px. */
+async function craft(page: Page) {
+  return page.evaluate(() => {
+    const visible = (el: Element) => { const r = el.getBoundingClientRect(); const s = getComputedStyle(el); return r.width > 0 && r.height > 0 && s.visibility !== "hidden" && s.display !== "none" && Number(s.opacity) > 0.05 && r.bottom > 0 && r.top < innerHeight && r.right > 0 && r.left < innerWidth; };
+    const label = (el: Element) => (el.getAttribute("aria-label") || el.textContent || "").trim().slice(0, 28);
+    const small = [...document.querySelectorAll('button, a[href], input, [role="button"], [role="option"], summary')].filter(visible)
+      .filter((el) => { const r = el.getBoundingClientRect(); return r.width < 43.5 || r.height < 43.5; }).map((el) => `${label(el)} ${Math.round(el.getBoundingClientRect().width)}×${Math.round(el.getBoundingClientRect().height)}`);
+    const tiny = [...document.querySelectorAll(".world *, .atlas-saved-views *, .atlas-product-identity *")].filter((el) => el.children.length === 0 && el.textContent!.trim() && visible(el))
+      .filter((el) => parseFloat(getComputedStyle(el).fontSize) < 12).map((el) => `${label(el)} ${getComputedStyle(el).fontSize}`);
+    return { small, tiny, overflowX: document.documentElement.scrollWidth - innerWidth };
+  });
+}
+
+test("R1 A — first open: Earth, one search line, one dock, nothing colliding", async ({ page }, testInfo) => {
+  compactOnly(testInfo.project.name);
+  await offlineWorld(page);
+  // NO INVISIBLE WORK at boot: the default (dark) visit loads exactly one basemap style.
+  const styles: string[] = [];
+  page.on("request", (request) => { if (/tiles\.openfreemap\.org\/styles\//.test(request.url())) styles.push(new URL(request.url()).pathname); });
+  await openAtlas(page);
+  expect(styles).toEqual(["/styles/dark"]);
+
+  expect(await surface(page)).toBe("REST");
+  const identity = await boxOf(page.locator(".atlas-product-identity"));
+  const search = await boxOf(page.locator(".search-line"));
+  const dock = await boxOf(page.locator(".atlas-dock"));
+  const zoom = await boxOf(page.locator(".maplibregl-ctrl-group").first());
+  for (const [a, b] of [[identity, search], [search, dock], [dock, zoom], [search, zoom]] as const) expect(overlaps(a, b)).toBe(false);
+
+  const viewport = page.viewportSize()!;
+  const covered = [identity, search, dock, zoom].reduce((sum, b) => sum + b.width * b.height, 0) / (viewport.width * viewport.height);
+  expect(covered, "the interface is a frame; Earth is the screen").toBeLessThan(0.2);
+
+  const quality = await craft(page);
+  expect(quality.overflowX).toBeLessThanOrEqual(1);
+  expect(quality.small, "touch targets under 44px").toEqual([]);
+  expect(quality.tiny, "text under 12px").toEqual([]);
+
+  // 16px is the floor below which iOS Safari zooms the page on focus and leaves it panned.
+  expect(parseFloat(await page.locator(".search-line input").evaluate((el) => getComputedStyle(el).fontSize))).toBeGreaterThanOrEqual(16);
+  await expect(page.locator(".atlas-hint")).toContainText("Tap anywhere on Earth");
+});
+
+test("R1 B — species: one result, real records, nothing over the panel", async ({ page }, testInfo) => {
+  compactOnly(testInfo.project.name);
+  await offlineWorld(page);
+  await openAtlas(page);
+
+  await page.locator(".search-line input").click();
+  await page.locator(".search-line input").fill("Orca");
+  await expect(page.locator(".results .ritem")).toHaveCount(1);
+  expect(await surface(page)).toBe("SEARCH");
+  await expect(page.locator(".atlas-dock")).toBeHidden();
+  expect((await craft(page)).overflowX).toBeLessThanOrEqual(1);
+
+  await page.locator(".results .ritem").first().click();
+  const panel = page.locator(".ctx");
+  await expect(panel.locator(".ctx-title")).toHaveText("Orca");
+  await expect(panel.locator(".lead-fact")).toContainText("31,418");
+  await expect(panel).not.toContainText(/no records/i);
+  await expect.poll(() => decodeURIComponent(page.url())).toContain("entity=taxon:gbif:2440483");
+
+  // Nothing floats over the header: the element under the close button IS the close button.
+  const close = await boxOf(panel.locator(".ctx-close"));
+  expect(await page.evaluate(([x, y]) => document.elementFromPoint(x, y)?.closest("button")?.className ?? "", [close.x + close.width / 2, close.y + close.height / 2])).toContain("ctx-close");
+  await expect(page.locator(".search-line")).toBeHidden();
+  await expect(page.locator(".atlas-dock")).toBeHidden();
+
+  const follow = await boxOf(panel.locator(".follow-btn"));
+  expect(follow.y + follow.height, "Follow is on the first read, without scrolling").toBeLessThanOrEqual(page.viewportSize()!.height);
+});
+
+test("R1 C — place: human first read, exact evidence one tap away, map stays the visitor's", async ({ page }, testInfo) => {
+  compactOnly(testInfo.project.name);
+  await offlineWorld(page);
+  await openAtlas(page);
+
+  await page.locator(".search-line input").click();
+  await page.locator(".search-line input").fill("Oslofjord");
+  await page.locator(".results .ritem").filter({ hasText: "Oslofjord" }).first().click();
+  const panel = page.locator(".ctx");
+  await expect(panel.locator(".ctx-title")).toHaveText("Oslofjord");
+  await expect(panel.getByText("Common eider")).toBeVisible();
+
+  const firstRead = await panel.evaluate((el) => { const copy = el.cloneNode(true) as HTMLElement; copy.querySelector(".evidence")?.remove(); return copy.innerText; });
+  expect(firstRead).not.toMatch(/place:4p|SEEDED|BOUNDING BOX|bounding box|°[NS]/);
+
+  const follow = await boxOf(panel.locator(".follow-btn"));
+  expect(follow.y + follow.height).toBeLessThanOrEqual(page.viewportSize()!.height);
+
+  // A real click on the native zoom control, with the sheet open.
+  const before = await camera(page);
+  await page.locator(".maplibregl-ctrl-zoom-in").click();
+  await expect.poll(async () => Math.abs((await camera(page)).zoom - before.zoom)).toBeGreaterThan(0.1);
+  await page.waitForFunction(() => !(window as any).__4planet_map.isMoving());
+  const owned = await camera(page);
+  await page.waitForTimeout(1_500);
+  const later = await camera(page);
+  expect(Math.abs(later.zoom - owned.zoom), "late data must not take the camera back").toBeLessThan(0.02);
+
+  await panel.locator(".evidence > summary").click();
+  const evidence = panel.locator(".evidence");
+  await expect(evidence).toContainText("place:4p:oslofjord");
+  await expect(evidence).toContainText("Bounding box");
+  await expect(evidence).toContainText("not the boundary of the place");
+  await expect(evidence).toContainText("GBIF");
+
+  await panel.locator(".follow-btn").click();
+  await expect(panel.locator(".follow-btn")).toHaveText(/Following/);
+});
+
